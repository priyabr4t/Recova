# ---- Infra ----
DATABASE_URL=postgresql://recova:recova@localhost:5432/recova
REDIS_URL=redis://localhost:6379
PORT=8080
LOG_LEVEL=info

# ---- Razorpay (test mode) ----
RAZORPAY_WEBHOOK_SECRET=
DEV_ALLOW_UNSIGNED=true

# ---- LLM (optional) ----
OPENAI_API_KEY=
OPENAI_BASE_URL=https://api.openai.com/v1
LLM_MODEL=gpt-4o-mini
LLM_TIMEOUT_MS=8000

# ---- Simulation ----
SIM_SEED=42

# ---- Auth / tenancy ----
# Session JWT signing secret — set a long random value outside development.
AUTH_SECRET=recova-dev-secret-change-me-in-production-0123456789
# Seeded demo login (created by npm run db:seed)
DEMO_USER_EMAIL=demo@recova.dev
DEMO_USER_PASSWORD=demo1234
