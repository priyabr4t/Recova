# ---- Infra (docker compose port mapping; change if 5432/6379 are taken) ----
# These must stay in sync with DATABASE_URL / REDIS_URL in backend/.env
POSTGRES_PORT=5432
REDIS_PORT=6379

# ---- Backend (copy this file to backend/.env) ----
DATABASE_URL=postgresql://recova:recova@localhost:5432/recova
REDIS_URL=redis://localhost:6379
PORT=8080
LOG_LEVEL=info

# ---- Razorpay (test mode) ----
# Used only for webhook signature verification. Leave empty in dev.
RAZORPAY_WEBHOOK_SECRET=
# When true, unsigned webhooks are accepted locally. NEVER true in a public deploy.
DEV_ALLOW_UNSIGNED=true

# ---- LLM (optional) ----
# If OPENAI_API_KEY is empty, Recova runs fully offline using deterministic
# fallbacks (error-code table + template emails). The demo must survive with
# this empty.
OPENAI_API_KEY=
OPENAI_BASE_URL=https://api.openai.com/v1
LLM_MODEL=gpt-4o-mini
LLM_TIMEOUT_MS=8000

# ---- Simulation ----
# Seed for the deterministic payment-outcome RNG. Same seed => same demo.
SIM_SEED=42
